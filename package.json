{
  "name": "xingji",
  "version": "0.1.0",
  "description": "一款本地优先、离线可用的个人行程记录与足迹统计应用。",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.mobile.config.ts",
    "build": "vite build --config vite.mobile.config.ts",
    "preview": "vite preview --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mac:build": "zsh scripts/build-macos-app.sh",
    "ios:add": "cap add ios",
    "ios:sync": "npm run mobile:build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@esmjs/geo": "^1.0.0",
    "d3-geo": "^3.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
